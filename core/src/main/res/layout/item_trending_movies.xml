<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Poster + Overlay Rating -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="250dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/trending_movies_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/roundedCorners"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

            <!-- Rating badge di pojok kanan atas -->
            <LinearLayout
                android:id="@+id/layout_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_rating">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="match_parent"
                    android:contentDescription="@string/rating_star_content_description"
                    android:src="@drawable/baseline_star_24" />

                <TextView
                    android:id="@+id/rating_trending_movies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="8.4"
                    android:textColor="@color/star"
                    android:textStyle="bold"
                    android:paddingStart="4dp" />
            </LinearLayout>
        </FrameLayout>

        <!-- Judul -->
        <TextView
            android:id="@+id/title_trending_movies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:textColor="@color/text_primary"
            android:maxLines="1"
            android:text="@string/title_movie"
            android:textSize="16sp"
            android:textStyle="bold"
            tools:text="Inception" />

        <!-- Release Date -->
        <TextView
            android:id="@+id/release_date_trending_movies"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            app:drawableStartCompat="@drawable/releasedate"
            app:drawableTint="@color/text_secondary"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="14sp"
            tools:text="2019" />

        <!-- Genre tag -->
        <TextView
            android:id="@+id/genre_trending_movies"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginVertical="8dp"
            android:layout_marginStart="8dp"
            android:paddingVertical="4dp"
            android:text="@string/genres"
            android:textColor="@android:color/holo_blue_dark"
            android:textSize="12sp"
            tools:ignore="TextContrastCheck"
            tools:text="Action" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
