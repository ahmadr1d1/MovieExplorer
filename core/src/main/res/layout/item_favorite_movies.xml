<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border_light"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Main Content -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="16dp">

            <!-- Poster Container -->
            <FrameLayout
                android:layout_width="120dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="16dp">

                <!-- Poster Image -->
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    app:cardCornerRadius="12dp"
                    app:cardElevation="4dp">

                    <ImageView
                        android:id="@+id/iv_favorite_poster"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        tools:src="@drawable/baseline_person_24" />

                </com.google.android.material.card.MaterialCardView>

                <!-- Rating Badge Container -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="top|end"
                    android:layout_margin="6dp"
                    android:background="@drawable/bg_rating"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="4dp">

                    <ImageView
                        android:layout_width="12dp"
                        android:layout_height="12dp"
                        android:layout_marginEnd="2dp"
                        android:src="@drawable/baseline_star_24" />

                    <TextView
                        android:id="@+id/tv_favorite_rating"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/star"
                        android:textSize="10sp"
                        android:textStyle="bold"
                        tools:text="8.4" />

                </LinearLayout>

            </FrameLayout>

            <!-- Movie Info -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <!-- Movie Header -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="vertical">

                    <!-- Movie Title -->
                    <TextView
                        android:id="@+id/tv_favorite_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="4dp"
                        android:ellipsize="end"
                        android:lineHeight="20dp"
                        android:maxLines="2"
                        android:text="Spider-Man: No Way Home"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Spider-Man: No Way Home" />

                    <!-- Movie Meta Information -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tv_release_date"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:textColor="@color/text_secondary"
                            app:drawableStartCompat="@drawable/releasedate"
                            app:drawableTint="@color/text_secondary"
                            android:textSize="12sp"
                            tools:text=" 2021" />

                        <TextView
                            android:id="@+id/tv_favorite_duration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="12dp"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/baseline_access_time_16"
                            app:drawableTint="@color/text_secondary"
                            tools:text="⏱️ 148 min" />

                        <TextView
                            android:id="@+id/tv_favorite_language"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/text_secondary"
                            android:textSize="12sp"
                            app:drawableStartCompat="@drawable/baseline_language_16"
                            app:drawableTint="@color/text_secondary"
                            tools:text="🌐 EN" />

                    </LinearLayout>

                    <!-- Genre Chips -->
                    <!-- Genre tag -->
                    <TextView
                        android:id="@+id/genre_favorite_movie"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="8dp"
                        android:paddingVertical="4dp"
                        android:textColor="@android:color/holo_blue_dark"
                        android:textSize="12sp"
                        tools:text="Action" />

                </LinearLayout>

                <!-- Overview -->
                <TextView
                    android:id="@+id/tv_favorite_overview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    android:ellipsize="end"
                    android:lineSpacingExtra="2dp"
                    android:maxLines="3"
                    android:text="Peter Parker is unmasked and no longer able to separate his normal life from the high-stakes of being a super-hero. When he asks for help from Doctor Strange the stakes become even more dangerous..."
                    android:textColor="@color/text_secondary"
                    android:textSize="13sp"
                    tools:text="Peter Parker is unmasked and no longer able to separate his normal life from the high-stakes of being a super-hero. When he asks for help from Doctor Strange the stakes become even more dangerous..." />

                <!-- Movie Actions -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <!-- Added Date -->
                    <TextView
                        android:id="@+id/tv_added_date"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Added"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        app:layout_constraintEnd_toEndOf="@+id/tv_added_date_format"
                        app:layout_constraintStart_toStartOf="@+id/tv_added_date_format"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/tv_added_date_format"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp"
                        tools:text="2 days ago"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@+id/tv_added_date" />


                    <!-- Remove Button -->
                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btn_remove"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="32dp"
                        android:minWidth="0dp"
                        android:paddingHorizontal="12dp"
                        android:text="🗑️ Remove"
                        android:textSize="11sp"
                        app:cornerRadius="16dp"
                        app:strokeColor="@color/border_light"
                        app:strokeWidth="1dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>