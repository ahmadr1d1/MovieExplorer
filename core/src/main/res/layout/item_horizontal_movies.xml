<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="160dp"
    android:layout_height="match_parent"
    android:layout_margin="8dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="4dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Portrait Poster + Overlay Rating -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="240dp">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/movies_image"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/movies_image_poster"
                android:scaleType="centerCrop"
                app:shapeAppearanceOverlay="@style/roundedCorners"
                tools:ignore="ImageContrastCheck"
                tools:srcCompat="@tools:sample/backgrounds/scenic" />

            <!-- Rating Badge -->
            <LinearLayout
                android:id="@+id/layout_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:background="@drawable/bg_rating"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingHorizontal="6dp"
                android:paddingVertical="4dp">

                <ImageView
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:contentDescription="@string/rating_star_content_description"
                    android:src="@drawable/baseline_star_24"
                    tools:ignore="ImageContrastCheck" />

                <TextView
                    android:id="@+id/rating_movies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:textColor="@color/star"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    tools:ignore="TextContrastCheck"
                    tools:text="8.4" />

            </LinearLayout>

        </FrameLayout>

        <!-- Content Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="12dp">

            <!-- Movie Title -->
            <TextView
                android:id="@+id/movies_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="3"
                android:maxWidth="120dp"
                android:text="@string/title_movie"
                android:textColor="@color/text_primary"
                android:textSize="14sp"
                android:textStyle="bold"
                tools:text="Inception" />

            <!-- Release Date -->
            <TextView
                android:id="@+id/movies_release_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:drawablePadding="4dp"
                android:ellipsize="end"
                android:gravity="center_vertical"
                android:maxLines="1"
                android:textColor="?android:attr/textColorSecondary"
                android:textSize="12sp"
                app:drawableStartCompat="@drawable/releasedate"
                app:drawableTint="@color/text_secondary"
                tools:text="2019" />

            <!-- Genre Tag -->
            <TextView
                android:id="@+id/movies_genres"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:ellipsize="end"
                android:maxWidth="120dp"
                android:maxLines="3"
                android:text="@string/genres"
                android:textColor="@android:color/holo_blue_dark"
                android:textSize="11sp"
                android:textStyle="bold"
                tools:ignore="TextContrastCheck"
                tools:text="Action" />

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>