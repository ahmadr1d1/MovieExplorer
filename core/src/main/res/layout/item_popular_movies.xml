<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/card_item"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content" >

            <ImageView
                android:id="@+id/popular_movies_image"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:contentDescription="@string/popular_movies_image"
                android:scaleType="fitXY"
                tools:src="@tools:sample/backgrounds/scenic" />

            <!-- Rating badge di pojok kanan atas -->
            <LinearLayout
                android:id="@+id/layout_rating"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="4dp"
                android:layout_gravity="top|end"
                android:layout_margin="8dp"
                android:layout_marginRight="4dp"
                android:background="@drawable/bg_rating">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="match_parent"
                    android:src="@drawable/baseline_star_24" />

                <TextView
                    android:id="@+id/rating_popular_movies"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="8.4"
                    android:textColor="@color/star"
                    android:textStyle="bold"
                    android:paddingStart="4dp" />
            </LinearLayout>
        </FrameLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                android:id="@+id/popular_movies_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="2"
                android:layout_marginEnd="4dp"
                android:textSize="16sp"
                android:textColor="@color/text_primary"
                android:fontFamily="@font/archivo_bold"
                android:textStyle="bold"
                android:text="@string/popular_movies_title"
                android:textAppearance="?attr/textAppearanceTitleLarge"
                tools:text="@tools:sample/lorem"

                />

            <TextView
                android:id="@+id/popular_movies_release_date"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginVertical="8dp"
                android:ellipsize="end"
                android:textSize="12sp"
                android:text="@string/popular_movies_release_date"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="?android:attr/textColorSecondary"
                tools:text="2014" />

            <!-- Genre tag -->
            <TextView
                android:id="@+id/genre_popular_movies"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:paddingVertical="4dp"
                android:text="Action"
                android:textSize="12sp"
                android:textColor="@android:color/holo_blue_dark"
                tools:text="Action" />
        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>